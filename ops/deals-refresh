#!/usr/bin/env bash
# Refresh the Deals table from a new pipeline build: datasets, a market fit, a publish.
#
#   ops/deals-refresh datasets [HASH]
#   ops/deals-refresh backtest-datasets [HASH]
#   ops/deals-refresh onefit NAME [HASH]
#   ops/deals-refresh fit NAME [HASH]
#   ops/deals-refresh backtest-fit NAME [HASH]
#   ops/deals-refresh publish RUN [OUT]
#   ops/deals-refresh publish-all RUN [OUT_ROOT]
#
# Run it from /data1/apartments/serve/master at origin/master. HASH is the hash of a
# pipeline rows file, as in rows-HASH.parquet, and defaults to the newest rows file. Before
# `datasets`, collect the open ads and build the pipeline:
#
#   ops/streeteasy-collect topup
#   systemctl --user start apartments-pipeline-build.service
#
# datasets  Writes, each from the last and each skipped when it exists:
#             b0-HASH-alldata                          rentfrontier.b0data, under the GPU lock
#             b0-HASH-alldata-dense                    rentfrontier.b0trim
#             b0-HASH-alldata-dense-nyc                rentfrontier.b0nyc, with the newest NJ
#                                                      registry (a registry older than the
#                                                      build leaves new NJ buildings in, and
#                                                      the fit stops at its design)
#             b0-HASH-alldata-dense-nyc-market         ops/market-dataset, every step but the
#                                                      backtest; its verify step runs on
#                                                      every call
#             b0-HASH-alldata-dense-nyc-market-closingraise
#                                                      rentfrontier.b0closingraise, when
#                                                      CLOSING_RAISE=1
#             b0-HASH-alldata-dense-nyc-market[-closingraise]-bedtext
#                                                      rentfrontier.b0bedtext
# backtest-datasets
#           Finishes the as-of ASOF backtest dataset
#           (b0-HASH-alldata-dense-nyc-asof-ASOFDAY[-closingraise]-bedtext). Requires
#           b0-HASH-alldata-dense-nyc-asof-ASOFDAY to exist (built by ops/market-dataset),
#           runs verify, then b0closingraise (when CLOSING_RAISE=1) and b0bedtext. ASOF
#           defaults to 2025-11-10.
#           The verify step also checks the build's market dataset when it exists, so
#           a failure there stops this step too. A closing-raise market run is published
#           with BACKTEST set to its own backtest run.
# fit       Launches the market fit of MODEL on Modal as run NAME, with the scales held at
#           SCALES and no scoring. Reads the market dataset matching CLOSING_RAISE. The
#           fit's note, with its predictions, must be on master first (CLAUDE.md). COMMIT
#           defaults to this checkout's HEAD and must be on origin/master.
# backtest-fit
#           Launches the held-scales Modal fit on the as-of ASOF backtest dataset matching
#           CLOSING_RAISE, with --split market, BASELINE defaulting to
#           drift-building-b0-market-67d14e17-j9 and SCALES to base-j9.
# publish   Writes the run's texts file, then the Deals files to OUT with BACKTEST as the
#           backtest. OUT defaults to a staging folder; compare it with the live files
#           before publishing to /data1/apartments/site/deals.
#
# MODEL, BASELINE, SCALES and BACKTEST default to the served pair of 2026-11-18
# (docs/notes/market-refresh-2026-11-18.md) and can be set in the environment.
# CLOSING_RAISE defaults to 0 (leave out b0closingraise, keeping the current chain); set
# CLOSING_RAISE=1 to include b0closingraise before b0bedtext in the dataset and fit steps.
set -euo pipefail

usage() {
    sed -n '2,11p' "$0" >&2
    exit 2
}

step=${1:-}
[[ -n $step ]] || usage
shift

root="$(cd "$(dirname "$0")/.." && pwd)"
cd "$root"
data=${APARTMENTS_ROOT:-/data1/apartments}
pipeline=$data/pipeline/datasets
external=$data/external
datasets=$data/frontier/datasets
py=/data1/apartments/venvs/sim-recovery/bin/python
deals_py=${DEALS_PY:-/data1/apartments/venvs/bridge-frontier/bin/python}
scratch=${DEALS_SCRATCH:-/data1/apartments/tmp/deals-refresh}
model=${MODEL:-drift-building-bedtext-layout-range}
baseline=${BASELINE:-drift-building-b0-market-67d14e17-n9}
scales=${SCALES:-base-n9}
backtest=${BACKTEST:-drift-building-bedtext-layout-range-b0-market-d9028c57-range-j}
onefit_model=${ONEFIT_MODEL:-drift-building-phase-unitkn-ablate}
onefit_variant=${ONEFIT_VARIANT:-layrng,size,sv_gp_mo,marks,seg_add,floor_poly,ad_core,scalar_sigma,biweekly_walk}
closing_raise=${CLOSING_RAISE:-0}
# Sets bt_args for a Deals publish. Unified and onefit runs validate on their own closed
# held-out rows, so they take no legacy backtest unless BACKTEST is set in the environment;
# every other run publishes with its backtest.
set_backtest_args() {
    local run_split
    run_split=$("$deals_py" -c 'import json, pathlib, sys
p = pathlib.Path(sys.argv[1]) / "result.json"
print(json.loads(p.read_text()).get("split", "") if p.exists() else "")' "$data/frontier/runs/$1")
    bt_args=()
    if [[ -n ${BACKTEST:-} ]] || [[ $run_split != onefit && $run_split != unified ]]; then
        bt_args=(--backtest "$backtest")
    fi
}

case $closing_raise in
0) cr_suffix="" ;;
1) cr_suffix="-closingraise" ;;
*)
    echo "CLOSING_RAISE must be 0 or 1, got $closing_raise" >&2
    exit 2
    ;;
esac

newest_hash() {
    local f
    f=$(ls -t "$pipeline"/rows-*.parquet | head -1)
    f=${f##*/rows-}
    echo "${f%.parquet}"
}

newest_registry() {
    ls -t "$external"/registry/*-extend*/registry.parquet | head -1
}

newest_nj_registry() {
    ls -t "$external"/registry-nj/*/registry.parquet | head -1
}

capped() {
    systemd-run --user --scope -q -p MemoryMax=6G -p MemorySwapMax=0 -- \
        env TMPDIR=/data1/apartments/tmp/pipeline/tmp JAX_PLATFORMS=cpu \
        PYTHONPATH=frontier/src "$@"
}

finish_dataset() {
    local target=$1 src=$1
    if [[ $closing_raise == 1 ]]; then
        [[ -e $target-closingraise ]] || capped "$py" -m rentfrontier.b0closingraise \
            "$target" "$target-closingraise"
        echo "== b0closingraise done"
        src=$target-closingraise
    fi
    [[ -e $src-bedtext ]] || capped "$py" -m rentfrontier.b0bedtext \
        "$src" "$src-bedtext"
    echo "== datasets done: $src-bedtext"
}

case $step in
datasets)
    hash=${1:-$(newest_hash)}
    base=$datasets/b0-$hash-alldata
    nj=${NJ_REGISTRY:-$(newest_nj_registry)}
    [[ -e $pipeline/rows-$hash.parquet ]] || { echo "no rows-$hash.parquet" >&2; exit 1; }
    [[ -e $nj ]] || { echo "no NJ registry at $nj" >&2; exit 1; }
    echo "build $hash, NJ registry $nj"
    [[ -e $base ]] || ops/job gpu -x -- systemd-run --user --scope -q \
        -p MemoryMax=6G -p MemorySwapMax=0 -- \
        env TMPDIR=/data1/apartments/tmp/pipeline/tmp PYTHONPATH=frontier/src \
        /data1/apartments/venvs/pipeline/bin/python -m rentfrontier.b0data "$base" \
        --state /data1/apartments/pipeline/state/pipeline.duckdb
    echo "== b0data done"
    [[ -e $base-dense ]] || capped "$py" -m rentfrontier.b0trim --allow-thin-last \
        "$base" "$base-dense"
    echo "== b0trim done"
    [[ -e $base-dense-nyc ]] ||
        capped "$py" -m rentfrontier.b0nyc "$base-dense" "$base-dense-nyc" --registry "$nj"
    echo "== b0nyc done"
    [[ -e $base-dense-nyc-market ]] ||
        ops/market-dataset "$hash" codes amenities units attrs age market
    # Runs on every call, so a rerun after a failed check stops here again.
    ops/market-dataset "$hash" verify
    echo "== market-dataset done"
    finish_dataset "$base-dense-nyc-market"
    ;;
backtest-datasets)
    hash=${1:-$(newest_hash)}
    asof=${ASOF:-2025-11-10}
    target=$datasets/b0-$hash-alldata-dense-nyc-asof-${asof//-/}
    [[ -e $pipeline/rows-$hash.parquet ]] || { echo "no rows-$hash.parquet" >&2; exit 1; }
    if [[ ! -e $target ]]; then
        cat >&2 <<EOF
no $target
build it first with ops/market-dataset, for example:
  ASOF=$asof ops/market-dataset $hash codes amenities units attrs age backtest
or, when snapshots for $hash already exist under DAY:
  DAY=YYYYMMDD ASOF=$asof ops/market-dataset $hash backtest
EOF
        exit 1
    fi
    # Runs on every call, so a rerun after a failed check stops here again.
    ASOF="$asof" ops/market-dataset "$hash" verify
    echo "== market-dataset done"
    finish_dataset "$target"
    ;;
onefit)
    name=${1:?usage: ops/deals-refresh onefit NAME [HASH]}
    hash=${2:-$(newest_hash)}
    commit=${COMMIT:-$(git rev-parse HEAD)}
    dataset=$datasets/b0-$hash-alldata-dense-nyc-market$cr_suffix-bedtext
    [[ -e $dataset/rows.parquet ]] || { echo "no dataset $dataset" >&2; exit 1; }
    git merge-base --is-ancestor "$commit" origin/master ||
        { echo "commit $commit is not on origin/master" >&2; exit 1; }
    echo "onefit build $hash, commit $commit, run $name, variant $onefit_variant"
    if [[ -n ${SCALES_FIXED:-} ]]; then
        exec ops/modal-fit --outside-budget --gpu "${GPU:-H100}" --large --lean \
            --dataset "$dataset" --input "$pipeline/rows-$hash.parquet" --split onefit \
            "$commit" "$name" "$onefit_model" b0 2 "${WARMUP:-200}" "${DRAWS:-2600}" "${KEEP:-30}" \
            --seed "${SEED:-1}" --variant "$onefit_variant" \
            --scales-fixed "$SCALES_FIXED" --budget-seconds "${BUDGET_SECONDS:-3600}" \
            --no-summary --no-loo --no-heldout
    fi
    for shard_seed in "a:1" "b:2"; do
        shard=${shard_seed%:*}
        seed=${shard_seed#*:}
        ops/modal-fit --outside-budget --gpu "${GPU:-H200}" --large --lean \
            --dataset "$dataset" --input "$pipeline/rows-$hash.parquet" --split onefit \
            "$commit" "$name-$shard" "$onefit_model" b0 2 "${WARMUP:-500}" "${DRAWS:-2600}" "${KEEP:-30}" \
            --seed "$seed" --variant "$onefit_variant" \
            --budget-seconds "${BUDGET_SECONDS:-4800}" \
            --no-summary --no-loo --no-heldout
    done
    ;;
fit | backtest-fit)
    name=${1:?usage: ops/deals-refresh $step NAME [HASH]}
    hash=${2:-$(newest_hash)}
    commit=${COMMIT:-$(git rev-parse HEAD)}
    if [[ $step == fit ]]; then
        dataset=$datasets/b0-$hash-alldata-dense-nyc-market$cr_suffix-bedtext
    else
        asof=${ASOF:-2025-11-10}
        baseline=${BASELINE:-drift-building-b0-market-67d14e17-j9}
        scales=${SCALES:-base-j9}
        dataset=$datasets/b0-$hash-alldata-dense-nyc-asof-${asof//-/}$cr_suffix-bedtext
    fi
    [[ -e $dataset/rows.parquet ]] || { echo "no dataset $dataset" >&2; exit 1; }
    git merge-base --is-ancestor "$commit" origin/master ||
        { echo "commit $commit is not on origin/master" >&2; exit 1; }
    echo "build $hash, commit $commit, run $name"
    exec ops/modal-fit --outside-budget --gpu H100 --dataset "$dataset" \
        --input "$pipeline/rows-$hash.parquet" --split market --baseline "$baseline" \
        "$commit" "$name" "$model" b0 2 200 3600 20 \
        --seed 1 --level-dof 4 --scales-fixed "$scales" --no-loo --no-heldout
    ;;
publish)
    run=${1:?usage: ops/deals-refresh publish RUN [OUT]}
    out=${2:-$scratch/$run/staging}
    registry=${REGISTRY:-$(newest_registry)}
    mkdir -p "$scratch/$run"
    echo "registry $registry"
    texts=$scratch/$run/texts.parquet
    export JAX_PLATFORMS=cpu PYTHONPATH=frontier/src TMPDIR=/data1/apartments/tmp
    # A texts table written before 2026-11-21 has no deposit column, which publish
    # refuses; write it again.
    if [[ -e $texts ]] && ! "$deals_py" -c 'import sys, pyarrow.parquet as pq
sys.exit("deposit" not in pq.read_schema(sys.argv[1]).names)' "$texts"; then
        echo "rewriting $texts: it has no deposit column"
        rm "$texts"
    fi
    [[ -e $texts ]] || "$deals_py" -m rentfrontier.drift_deals texts "$run" --out "$texts"
    set_backtest_args "$run"
    "$deals_py" -m rentfrontier.drift_deals publish "$run" --out "$out" \
        --registry "$registry" "${bt_args[@]}" --texts "$texts"
    echo "== published to $out"
    ;;
publish-all)
    run=${1:?usage: ops/deals-refresh publish-all RUN [OUT_ROOT]}
    out_root=${2:-$scratch/$run/site-staging}
    registry=${REGISTRY:-$(newest_registry)}
    mkdir -p "$out_root" "$scratch/$run"
    echo "registry $registry"
    texts=$scratch/$run/texts.parquet
    export JAX_PLATFORMS=cpu PYTHONPATH=frontier/src TMPDIR=/data1/apartments/tmp
    if [[ -e $texts ]] && ! "$deals_py" -c 'import sys, pyarrow.parquet as pq
sys.exit("deposit" not in pq.read_schema(sys.argv[1]).names)' "$texts"; then
        echo "rewriting $texts: it has no deposit column"
        rm "$texts"
    fi
    [[ -e $texts ]] || "$deals_py" -m rentfrontier.drift_deals texts "$run" --out "$texts"
    set_backtest_args "$run"
    "$deals_py" -m rentfrontier.drift_deals publish "$run" --out "$out_root/deals" \
        --registry "$registry" "${bt_args[@]}" --texts "$texts"
    "$deals_py" -m rentfrontier.drift_estimates publish "$run" --out "$out_root/estimates" \
        --registry "$registry"
    "$deals_py" -m rentfrontier.drift_diagnostics publish "$run" --out "$out_root/diagnostics" \
        --registry "$registry" --features "$external"
    echo "== staged deals, estimates, diagnostics under $out_root"
    ;;
*)
    usage
    ;;
esac
