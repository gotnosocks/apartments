[Unit]
Description=Rebuild the rents site's research data every 10 minutes (a fallback for the .path trigger; skips when nothing is new)

[Timer]
# Wall-clock schedule: OnUnitActiveSec does not re-arm reliably for a oneshot
# service, which never stays "active".
OnCalendar=*:0/10
AccuracySec=30s

[Install]
WantedBy=timers.target
