#!/bin/bash
# Build the data pipeline's fit-ready rows after each backfill run and each Friday top-up.
# apartments-pipeline-build.service runs this script when the StreetEasy exporter changes the
# export's manifest, and once a day from its timer. The script works in these steps:
#
# 1. It waits for oxylabs.lock and lets go of it at once. The collector holds the lock through
#    each run and its export, so the build starts after the export's last file.
# 2. It moves its own checkout, /data1/apartments/pipeline/code, to master and syncs the venv
#    from pipeline/uv.lock. Only apartments-city-fetch.service also runs code from that
#    checkout, on the system's Python. Nothing else uses the venv. When the export's manifest,
#    the city archive's manifest and the commit's trees for pipeline/, src/ and ops/pipeline/
#    match the ones it wrote to $STATE/last-build after the last build, it stops there.
# 3. It waits for room to build, checking that
#      - no job holds the GPU lock, as a fit, a GPU summary or any other `ops/job gpu` job does;
#      - no user unit matching a pattern of PIPELINE_BUILD_AVOID is active. The patterns take in
#        the site builds and Data improvements' jobs, which can run outside `ops/job` and then
#        hold no light slot;
#      - PIPELINE_BUILD_GIB GiB of memory is available, 5 unless set.
#    While a GPU job holds the GPU lock, the script queues for the lock as GPU jobs do and holds
#    it through the build, so the build never starts beside a fit and never waits behind a
#    stream of them. With the GPU lock free, the build leaves it free, and a GPU job can start
#    while it runs. Once the other checks pass, the script takes every light slot, so no
#    `ops/job light` job runs beside the build, and checks again with the slots held. When a
#    check fails, it lets go of every lock and tries again a minute later. The log gives each
#    new reason to wait, then the locks the build took and the memory available at its start.
# 4. It runs ops/pipeline/build.py in the service's own cgroup, where the unit caps memory and
#    turns swap off. The build writes its rows file, ads file and catalog line to
#    /data1/apartments/pipeline/datasets. Then the script lets go of its locks.
# 5. When the manifest changed while the build ran, it goes back to step 1.
#
# When the build fails, the script exits with the build's status and the service shows as failed.
#
# `build-latest --room [held]` runs only the checks of step 3, prints the reason to wait or the
# memory available, and exits 1 or 0. With `held`, it skips the GPU lock, as when the build holds
# it.
set -uo pipefail
# The script lives in the checkout it updates: read it whole before running.
{

CODE=${CODE:-/data1/apartments/pipeline/code}
CRAWLS=${CRAWLS:-/data1/apartments/archive/crawls}
LOCKS=${APARTMENTS_LOCKS:-/data1/apartments/tmp/locks}
STATE=/data1/apartments/pipeline/state
MANIFEST=$CRAWLS/api/export/manifest.ndjson
CITY=${PIPELINE_CITY:-/data1/apartments/archive/city}
export UV_PROJECT_ENVIRONMENT=${UV_PROJECT_ENVIRONMENT:-/data1/apartments/venvs/pipeline}
export TMPDIR=${TMPDIR:-/data1/apartments/pipeline/tmp}
export PIPELINE_MEMORY=${PIPELINE_MEMORY:-3GB}
export CUDA_VISIBLE_DEVICES= JAX_PLATFORMS=cpu
AVOID=${PIPELINE_BUILD_AVOID-site-build-* frontier-publish* di-* bd4-*}
GIB=${PIPELINE_BUILD_GIB:-5}
if ! [[ $GIB =~ ^[0-9]+([.][0-9]+)?$ ]]; then
  echo "PIPELINE_BUILD_GIB=$GIB is not a number of GiB" >&2
  exit 2
fi

# The light slots go on fds 5 to 7, as ops/job takes them, and the GPU lock on fd 9.
take_slots() {
  for i in 1 2 3; do
    eval "exec $((4 + i))>\"\$LOCKS/light-$i.lock\"" && flock $((4 + i)) || return 1
  done
}
drop_locks() { exec 5>&- 6>&- 7>&- 9>&-; }

# The checks of step 3: print a reason to wait and return 1, or print the memory available.
room() {
  if [ "${1-}" != held ] && ! flock -n "$LOCKS/gpu.lock" true; then
    echo "gpu: a GPU job holds the GPU lock"
    return 1
  fi
  # The patterns go to systemctl unquoted, one argument each, and systemctl matches them. With
  # no pattern it would list every unit, so the check needs one.
  if [[ $AVOID =~ [^[:space:]] ]]; then
    local units status=0
    set -f
    # shellcheck disable=SC2086
    units=$(systemctl --user list-units --plain --no-legend \
      --state=active,activating,deactivating,reloading $AVOID | awk '{print $1}' |
      paste -sd ' ') || status=$?
    set +f
    if [ "$status" -ne 0 ]; then
      echo "units: systemctl --user list-units failed"
      return 1
    fi
    if [ -n "$units" ]; then
      echo "units: $units active"
      return 1
    fi
  fi
  local kib
  kib=$(awk '/^MemAvailable:/ {print $2}' /proc/meminfo)
  if ! awk -v kib="$kib" -v gib="$GIB" 'BEGIN {exit !(kib >= gib * 1048576)}'; then
    echo "memory: $((kib / 1024)) MiB available, under $GIB GiB"
    return 1
  fi
  echo "$((kib / 1024)) MiB available"
}

if [ "${1-}" = --room ]; then
  room "${2-}"
  exit
fi
mkdir -p "$TMPDIR"

while :; do
  echo "$(date -Is) waiting for $CRAWLS/oxylabs.lock"
  flock -s "$CRAWLS/oxylabs.lock" true || exit 1
  listed=$(sha256sum <"$MANIFEST")

  git -C "$CODE" fetch -q origin master || true
  git -C "$CODE" checkout -q --force --detach origin/master || exit 1
  /home/ben/.local/bin/uv sync -q --locked --project "$CODE/pipeline" || exit 1
  inputs="$listed $(sha256sum <"$CITY/manifest.ndjson") $(git -C "$CODE" rev-parse HEAD:pipeline HEAD:src HEAD:ops/pipeline | tr '\n' ' ')"
  if [ "$(cat "$STATE/last-build" 2>/dev/null)" = "$inputs" ]; then
    echo "$(date -Is) the export, the city archive and the code match the last build"
    break
  fi

  echo "$(date -Is) waiting for room to build"
  # The log gets a line when the reason to wait changes, not every minute.
  last=
  while :; do
    gpu=free
    if ! flock -n "$LOCKS/gpu.lock" true; then
      [ "$last" = queue ] || echo "$(date -Is) waiting: queueing for the GPU lock a GPU job holds"
      last=queue
      exec 9>"$LOCKS/gpu.lock" && flock 9 || exit 1
      gpu=held
    fi
    if room=$(room $gpu); then
      take_slots || exit 1
      room=$(room $gpu) && break
    fi
    drop_locks
    [ "${room%%:*}" = "$last" ] || echo "$(date -Is) waiting: $room"
    last=${room%%:*}
    sleep 60
  done
  if [ "$gpu" = held ]; then
    echo "$(date -Is) took light-1, light-2, light-3 and the GPU lock, $room"
  else
    echo "$(date -Is) took light-1, light-2 and light-3, left the GPU lock free, $room"
  fi
  echo "$(date -Is) building from $(git -C "$CODE" rev-parse --short HEAD)"
  "$UV_PROJECT_ENVIRONMENT/bin/python" "$CODE/ops/pipeline/build.py" || exit $?
  drop_locks
  echo "$inputs" >"$STATE/last-build"

  [ "$(sha256sum <"$MANIFEST")" = "$listed" ] && break
  echo "$(date -Is) the manifest changed during the build"
done

exit
}
