#!/usr/bin/env bash
# Search the web. Usage: web-search [--scholar] QUERY...
#   default: DuckDuckGo HTML results (title + URL)
#   --scholar: OpenAlex works (title, year, DOI, landing URL) plus arXiv
set -euo pipefail
LIB="$(dirname "$(readlink -f "$0")")/../lib"
scholar=""; if [ "${1:-}" = "--scholar" ]; then scholar=1; shift; fi
q="$*"; enc="$(python3 -I -c 'import sys,urllib.parse;print(urllib.parse.quote_plus(sys.argv[1]))' "$q")"
if [ -n "$scholar" ]; then
  curl -sS -m 30 "https://api.openalex.org/works?search=$enc&per_page=10&select=title,publication_year,doi,primary_location" \
    | python3 -I -c 'import json,sys
for w in json.load(sys.stdin).get("results",[]):
    loc=(w.get("primary_location") or {}).get("landing_page_url")
    print(w.get("publication_year"), w.get("title"), "\n   ", w.get("doi") or loc)'
  echo "--- arXiv"
  curl -sS -m 30 "https://export.arxiv.org/api/query?search_query=all:$enc&max_results=5" \
    | python3 -I -c 'import re,sys
s=sys.stdin.read()
for e in re.findall(r"<entry>(.*?)</entry>",s,re.S):
    t=re.search(r"<title>(.*?)</title>",e,re.S).group(1); i=re.search(r"<id>(.*?)</id>",e).group(1)
    print(" ".join(t.split()), "\n   ", i)'
else
  curl -sS -m 30 -A "Mozilla/5.0 (X11; Linux x86_64)" "https://html.duckduckgo.com/html/?q=$enc" | python3 -I "$LIB/html2text.py" --ddg | head -40
fi
