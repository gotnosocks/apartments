[Unit]
Description=Apartments rental review (thelio primary archive)
ConditionPathIsMountPoint=/data1
ConditionPathExists=/data1/apartments/migration/cutover-ready.json

[Service]
Type=simple
WorkingDirectory=/home/ben/code/apartments
ExecStart=/home/ben/code/apartments/.venv/bin/python -m apartments.review_web --dataset-root /data1/apartments/archive/datasets/chelsea-granular-20260916 --review-state /data1/apartments/archive/reviews/chelsea-granular-20260916 --port 8766
Restart=on-failure
RestartSec=5
Environment=OMP_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=2
Environment=PYTHONUNBUFFERED=1
MemoryMax=3G
UMask=0077

[Install]
WantedBy=default.target
