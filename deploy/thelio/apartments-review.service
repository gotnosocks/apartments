[Unit]
Description=Apartments rental review (thelio primary archive)
ConditionPathIsMountPoint=/data1
ConditionPathExists=/data1/apartments/migration/cutover-ready.json

[Service]
Type=simple
WorkingDirectory=/home/ben/code/apartments
ExecStart=/home/ben/.local/bin/uv run --no-sync python -m apartments.review_web --dataset-root /data1/apartments/archive/datasets/chelsea-granular-20260917-canonical-units --review-state /data1/apartments/archive/reviews/chelsea-granular-20260917-canonical-units --port 8766
Restart=on-failure
RestartSec=5
Environment=OMP_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=2
Environment=PYTHONUNBUFFERED=1
Environment=REVIEW_MODEL_REPORT=/data1/apartments/archive/fits/chelsea-bayesian-20260918-final/report/report.html
Environment="REVIEW_LISTEN=127.0.0.1:8766 100.80.84.126:8766"
Environment=REVIEW_ALLOWED_HOSTS=thelio,thelio.tail3983e0.ts.net,100.80.84.126
MemoryMax=3G
UMask=0077

[Install]
WantedBy=default.target
