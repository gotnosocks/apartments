[Unit]
Description=Validate migrated archive and activate thelio services
ConditionPathIsMountPoint=/data1
ConditionPathExists=/data1/apartments/migration/all-files.jsonl
ConditionPathExists=!/data1/apartments/migration/cutover-ready.json

[Service]
Type=oneshot
WorkingDirectory=/home/ben/code/apartments
ExecStart=/home/ben/code/apartments/.venv/bin/python -m apartments.archive_cutover
ExecStartPost=/usr/bin/systemctl --user start apartments-review.service apartments-archive.service
TimeoutStartSec=7200
Environment=PYTHONUNBUFFERED=1
Environment=OMP_NUM_THREADS=2
Environment=OPENBLAS_NUM_THREADS=2
MemoryMax=2G
UMask=0077
