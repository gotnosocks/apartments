[Unit]
Description=Download and verify the frozen Modal archive
ConditionPathIsMountPoint=/data1
ConditionPathExists=!/data1/apartments/migration/cutover-ready.json
OnSuccess=apartments-migration-finalize.service

[Service]
Type=simple
WorkingDirectory=/home/ben/code/apartments
Environment=MODAL_CONFIG_PATH=/home/ben/.config/apartments/modal-migration.toml
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/ben/code/apartments/.venv/bin/python -m apartments.archive_receive
Restart=no
MemoryMax=3G
UMask=0077

[Install]
WantedBy=default.target
